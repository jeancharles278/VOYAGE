# ---------------------------------------------------------------------------
# VOYAGE — variables d'environnement
# Aucune de ces variables n'est obligatoire pour lancer le MVP :
# l'application bascule automatiquement sur les providers "mock".
# ---------------------------------------------------------------------------

# --- Météo ---------------------------------------------------------------
# Fournisseur actif : "mock" (defaut) | "openweathermap" | "weatherapi"
WEATHER_PROVIDER=mock
OPENWEATHERMAP_API_KEY=
WEATHERAPI_API_KEY=
# Meteomatics (prévisions long terme / climatologie)
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# --- Cartographie --------------------------------------------------------
# Sans token, la carte utilise les tuiles OpenStreetMap (aucune clé requise).
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAP_PROVIDER=osm

# --- Hébergement / vols / locations --------------------------------------
# Amadeus alimente les vols et les hôtels de la fiche destination.
#
#   AMADEUS_MODE=off       Amadeus désactivé (défaut sans identifiants)
#   AMADEUS_MODE=fixtures  rejoue les réponses enregistrées de fixtures/amadeus/
#                          — chemin de code réel, aucun identifiant requis
#   AMADEUS_MODE=live      appels réels (automatique si les deux clés existent)
AMADEUS_MODE=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# `test` (bac à sable, inventaire limité) ou `production`
AMADEUS_ENVIRONMENT=test

# Locations : encore simulées
RENTAL_PROVIDER=mock
BOOKING_API_KEY=
RAPIDAPI_KEY=

# --- Supabase (optionnel : favoris/comptes synchronisés) ------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (recherche en langage naturel avancée) --------------------------
NLP_PROVIDER=rule-based
ANTHROPIC_API_KEY=
