# ---------------------------------------------------------------------------
# VOYAGE — variables d'environnement
# Aucune de ces variables n'est obligatoire pour lancer le MVP :
# l'application bascule automatiquement sur les providers "mock".
# ---------------------------------------------------------------------------

# --- Météo ---------------------------------------------------------------
# Fournisseur actif : "mock" (defaut) | "openweathermap" | "weatherapi"
WEATHER_PROVIDER=mock
OPENWEATHERMAP_API_KEY=
WEATHERAPI_API_KEY=
# Meteomatics (prévisions long terme / climatologie)
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# --- Cartographie --------------------------------------------------------
# Sans token, la carte utilise les tuiles OpenStreetMap (aucune clé requise).
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAP_PROVIDER=osm

# --- Hébergement / vols / locations --------------------------------------
HOTEL_PROVIDER=mock
FLIGHT_PROVIDER=mock
RENTAL_PROVIDER=mock
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
BOOKING_API_KEY=
RAPIDAPI_KEY=

# --- Supabase (optionnel : favoris/comptes synchronisés) ------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (recherche en langage naturel avancée) --------------------------
NLP_PROVIDER=rule-based
ANTHROPIC_API_KEY=
